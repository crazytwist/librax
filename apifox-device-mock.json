      "item": [

        {
          "name": "🔗 端到端测试 - pH 计测量（自动回调）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resp = pm.response.json();",
                  "pm.test('执行提交成功', () => pm.expect(resp.code).to.eql(0));",
                  "",
                  "const data = resp.data;",
                  "if (!data || !data.execId) { console.error('❌ 未获取到 execId'); return; }",
                  "",
                  "pm.collectionVariables.set('exec_id', data.execId);",
                  "console.log('📤 execId:', data.execId, '| deviceId:', data.deviceId);",
                  "",
                  "// 等待 500ms 后自动触发成功回调（模拟设备处理时间）",
                  "setTimeout(() => {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('base_url') + '/device/callback/' + data.execId + '/direct',",
                  "        method: 'POST',",
                  "        header: [{ key: 'Content-Type', value: 'application/json' }],",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                callbackToken: '',",
                  "                success: true,",
                  "                data: {",
                  "                    value: (6.5 + Math.random()).toFixed(2),",
                  "                    unit: 'pH',",
                  "                    temperature: (24 + Math.random()).toFixed(1)",
                  "                }",
                  "            })",
                  "        }",
                  "    }, (err, callbackResp) => {",
                  "        if (err) { console.error('❌ 回调发送失败:', err); return; }",
                  "        console.log('📡 回调已发送，响应:', callbackResp.code);",
                  "        ",
                  "        // 再等 300ms 查询结果",
                  "        setTimeout(() => {",
                  "            pm.sendRequest({",
                  "                url: pm.collectionVariables.get('base_url') + '/lab/device-command/execute/result?execId=' + data.execId,",
                  "                method: 'GET',",
                  "                header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('token') }]",
                  "            }, (err2, resultResp) => {",
