                  "                const result = resultResp.json();",
                  "                console.log('📊 最终状态:', result.data.status, '| 错误码:', result.data.errorCode);",
                  "                pm.test('最终状态为 FAILED', () => pm.expect(result.data.status).to.eql('FAILED'));",
                  "                pm.test('错误码正确', () => pm.expect(result.data.errorCode).to.eql('SENSOR_ERROR'));",
                  "            });",
                  "        }, 300);",
                  "    });",
                  "}, 500);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/lab/device-command/execute",
              "host": ["{{base_url}}"],
              "path": ["lab", "device-command", "execute"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceType\": \"PH_METER\",\n  \"commandCode\": \"MEASURE\",\n  \"params\": { \"sampleCount\": 1 },\n  \"timeoutMs\": 30000\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },

        {
          "name": "🔗 端到端测试 - 超时场景",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resp = pm.response.json();",
                  "pm.test('执行提交成功', () => pm.expect(resp.code).to.eql(0));",
                  "const data = resp.data;",
                  "if (!data || !data.execId) return;",
                  "pm.collectionVariables.set('exec_id', data.execId);",
                  "console.log('⌛ 超时测试：timeoutMs=2000，2.5秒后查询应返回 TIMEOUT');",
                  "",
                  "// 2500ms 后查询（此时已超过 2000ms 超时，不触发回调）",
                  "setTimeout(() => {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('base_url') + '/lab/device-command/execute/result?execId=' + data.execId,",
                  "        method: 'GET'",
                  "    }, (err, resultResp) => {",
                  "        const result = resultResp.json();",
                  "        console.log('📊 超时检测结果:', result.data.status);",
                  "        pm.test('最终状态为 TIMEOUT', () => pm.expect(result.data.status).to.eql('TIMEOUT'));",
                  "    });",
                  "}, 2500);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/lab/device-command/execute",
              "host": ["{{base_url}}"],
              "path": ["lab", "device-command", "execute"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceType\": \"PH_METER\",\n  \"commandCode\": \"MEASURE\",\n  \"params\": { \"sampleCount\": 1 },\n  \"timeoutMs\": 2000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "timeoutMs 故意设为 2000ms，脚本不发回调，2.5秒后查询结果应为 TIMEOUT"
          },
          "response": []
        }

      ]
    }

  ]
}
