<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.librax.boot</groupId>
        <artifactId>librax</artifactId>
        <version>${revision}</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>librax-module-device</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <name>${project.artifactId}</name>

    <dependencies>
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-module-flow-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-module-device-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-biz-ip</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- DB 相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- 消息队列相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-mq</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.librax.boot</groupId>
            <artifactId>librax-spring-boot-starter-excel</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>com.googlecode.aviator</groupId>
            <artifactId>aviator</artifactId>
        </dependency>

    </dependencies>

</project>