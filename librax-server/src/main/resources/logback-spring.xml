<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      日志格式说明：
        [exec:%X{executionId}] — 流程执行ID，MDC 注入，Promtail 提取为 Loki 标签
        [node:%X{nodeId}]      — 节点ID，MDC 注入，Promtail 提取为 Loki 标签
        %-5level               — 日志级别，左对齐5字符
        %logger{50}:%L         — 类名:行号
    -->

    <!-- 控制台格式：带高亮 + MDC -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [exec:%X{executionId}] [node:%X{nodeId}] %highlight(%-5level) %cyan(%logger{50}:%L) - %msg%n"/>

    <!-- 文件格式：无高亮 + MDC（Promtail 从这个格式提取标签） -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [exec:%X{executionId}] [node:%X{nodeId}] %-5level %logger{50}:%L - %msg%n"/>

    <!-- 日志文件路径（和 docker-compose.yml 里挂载的目录一致） -->
    <property name="LOG_PATH" value="/Users/yinan/workspace/logs"/>
    <property name="LOG_FILE" value="${LOG_PATH}/librax.log"/>

    <!-- ================================================================
         控制台 Appender
         ================================================================ -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ================================================================
         文件 Appender（Promtail 从这个文件采集日志推送到 Loki）
         ================================================================ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/librax.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>50MB</maxFileSize>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ================================================================
         异步写入（不阻塞业务线程）
         ================================================================ -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 队列满时不丢弃 INFO 以下日志 -->
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- ================================================================
         SkyWalking（备用，需要时取消注释）
         ================================================================ -->
    <!--
    <appender name="SKYWALKING" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>[%tid] ${FILE_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>
    -->

    <!-- ================================================================
         降噪：框架内部日志只输出 ERROR
         ================================================================ -->
    <logger name="org.springframework.context.annotation.ConfigurationClassPostProcessor"
            level="ERROR" additivity="false"/>
    <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate"
            level="ERROR" additivity="false"/>
    <logger name="com.baomidou.mybatisplus"        level="WARN" additivity="false"/>
    <logger name="com.zaxxer.hikari"               level="WARN" additivity="false"/>
    <logger name="org.springframework.data.redis"  level="WARN" additivity="false"/>

    <!-- ================================================================
         Root
         ================================================================ -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC"/>
        <!-- <appender-ref ref="SKYWALKING"/> -->
    </root>

</configuration>